{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ddata-lib": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ddata-lib",
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/doc"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "sourceMap": true,
            "optimization": false,
            "browser": "src/main.ts",
            "extractLicenses": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "test": {
              "optimization": false,
              "sourceMap": true,
              "polyfills": []
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ddata-lib:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "ddata-lib:build:production"
            },
            "development": {
              "buildTarget": "ddata-lib:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ddata-lib:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "ddata-lib:build:test"
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "ddata-lib:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "ddata-lib:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "ddata-core": {
      "projectType": "library",
      "root": "projects/ddata-core",
      "sourceRoot": "projects/ddata-core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ddata-core/tsconfig.lib.json",
            "project": "projects/ddata-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ddata-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ddata-core/tsconfig.lib.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ddata-core/tsconfig.spec.json",
            "setupFiles": [
              "projects/ddata-core/src/test-setup.ts"
            ],
            "exclude": [
              "**/test.model.spec.ts",
              "**/test-bed-configuration.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ddata-core/**/*.ts",
              "projects/ddata-core/**/*.html"
            ]
          }
        }
      }
    },
    "ddata-ui": {
      "projectType": "library",
      "root": "projects/ddata-ui",
      "sourceRoot": "projects/ddata-ui/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ddata-ui/tsconfig.lib.json",
