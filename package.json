{
  "name": "ddata-lib",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test ddata-lib --no-watch --browsers=ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "publish:ddata-core:patch-version": "cd projects/ddata-core && npm version patch && cd ../.. && ng build ddata-core --configuration production && cd dist/ddata-core && npm publish && cd ../..",
    "publish:ddata-ui:patch-version": "cd projects/ddata-ui && npm version patch && cd ../.. && ng build ddata-ui --configuration production && cd dist/ddata-ui && npm publish && cd ../..",
    "build:a11y": "ng build ddata-a11y --configuration production",
    "build:core": "ng build ddata-core --configuration production",
    "build:ui-common": "ng build ddata-ui-common --configuration production",
    "build:ui-dialog": "ng build ddata-ui-dialog --configuration production",
    "build:ui-file": "ng build ddata-ui-file --configuration production",
    "build:ui-input": "ng build ddata-ui-input --configuration production",
    "publish:a11y": "cd dist/ddata-a11y && npm publish && cd ../..",
    "publish:core": "cd dist/ddata-core && npm publish && cd ../..",
    "publish:ui-common": "cd dist/ddata-ui-common && npm publish && cd ../..",
    "publish:ui-dialog": "cd dist/ddata-ui-dialog && npm publish && cd ../..",
    "publish:ui-file": "cd dist/ddata-ui-file && npm publish && cd ../..",
    "publish:ui-input": "cd dist/ddata-ui-input && npm publish && cd ../.."
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^22.2.2",
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@dhutaryan/ngx-mat-timepicker": "^22.0.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "luxon": "^3.7.2",
    "moment": "^2.31.0",
    "ngx-color-picker": "^20.1.1",
    "ngx-daterangepicker-material": "^22.0.0",
    "pluralize": "^8.0.0",
    "rxjs": "~7.8.2",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/jasmine": "~7.0.0",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "angular-eslint": "^22.5.0",
    "codelyzer": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^77.0.0",
    "jasmine-core": "~7.0.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.9",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "tslib": "^2.8.1",
    "tslint": "~6.1.3",
    "typescript": "^6.0.3"
  }
