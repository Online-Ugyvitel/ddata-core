{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "@netdjw/ddata-core": [
        "dist/ddata-core/ddata-core",
        "dist/ddata-core"
      ],
      "ddata-ui": [
        "dist/ddata-ui/ddata-ui",
        "dist/ddata-ui"
      ],
      "@netdjw/ddata-ui-input": [
        "dist/ddata-ui-input/ddata-ui-input",
        "dist/ddata-ui-input"
      ],
      "@netdjw/ddata-ui-file": [
        "dist/ddata-ui-file/ddata-ui-file",
        "dist/ddata-ui-file"
      ],
      "@netdjw/ddata-ui-dialog": [
        "dist/ddata-ui-dialog/ddata-ui-dialog",
        "dist/ddata-ui-dialog"
      ],
      "@netdjw/ddata-ui-common": [
        "dist/ddata-ui-common/ddata-ui-common",
        "dist/ddata-ui-common"
      ],
      "@netdjw/ddata-a11y": [
        "dist/ddata-a11y/ddata-a11y",
        "dist/ddata-a11y"
      ]
    },
    "useDefineForClassFields": false
  }
}
